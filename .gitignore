*.class

# IDE files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.classpath
.project
.settings/

# Node / Frontend
node_modules/
dist/
.env
.env.local

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Docker volumes / data
*.log
